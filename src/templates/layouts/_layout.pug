include ../mixins/all
doctype html
html(lang="ru")
  head
    block vars
    include _head
  body(class=bodyClass)
    .out(class=outClass)
      block header
        include ../partials/_header
      main.main-content
        block content
      block footer
        include ../partials/_footer
    +cookies()
    block scripts
      script(type="module" src="/js/app.js")
