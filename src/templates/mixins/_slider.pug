mixin slider()
  <section class="ui-slider">
    <div class="container">
      <div class="section-head">
        <h2 class="title">Галерея</h2>
        <p class="section-head__subtitle">Пример слайдера</p>
      </div>
      <div class="ui-slider__root glide js-ui-slider">
        <div class="glide__track ui-slider__track" data-glide-el="track">
          <ul class="ui-slider__list glide__slides">
            <li class="ui-slider__item glide__slide">
              <a class="ui-slider__link" href="./img/slider/1.jpg" data-gallery="main-gallery">
                <img src="./img/slider/1.jpg" alt="Слайд 1" />
              </a>
            </li>
            <li class="ui-slider__item glide__slide">
              <a class="ui-slider__link" href="./img/slider/2.jpg" data-gallery="main-gallery">
                <img src="./img/slider/2.jpg" alt="Слайд 2" />
              </a>
            </li>
            <li class="ui-slider__item glide__slide">
              <a class="ui-slider__link" href="./img/slider/3.jpg" data-gallery="main-gallery">
                <img src="./img/slider/3.jpg" alt="Слайд 3" />
              </a>
            </li>
            <li class="ui-slider__item glide__slide">
              <a class="ui-slider__link" href="./img/slider/1.jpg" data-gallery="main-gallery">
                <img src="./img/slider/1.jpg" alt="Слайд 4" />
              </a>
            </li>
          </ul>
        </div>
        <div class="ui-slider__arrows" data-glide-el="controls">
          <button class="ui-slider__arrow ui-slider__arrow--prev" type="button" data-glide-dir="&lt;" aria-label="Предыдущий слайд">
            <svg class="icon icon-chevron-right" aria-hidden="true" focusable="false">
              <use href="#icon-chevron-right" xlink:href="#icon-chevron-right"></use>
            </svg>
          </button>
          <button class="ui-slider__arrow ui-slider__arrow--next" type="button" data-glide-dir="&gt;" aria-label="Следующий слайд">
            <svg class="icon icon-chevron-right" aria-hidden="true" focusable="false">
              <use href="#icon-chevron-right" xlink:href="#icon-chevron-right"></use>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>
