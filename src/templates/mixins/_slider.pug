mixin slider(config = {})
  - const title = config.title || ''
  - const subtitle = config.subtitle || ''
  - const titleMods = config.titleMods || ''
  - const subtitleMods = config.subtitleMods || ''
  - const headMods = config.headMods || ''
  - const sectionClass = config.sectionClass || ''
  - const slides = config.slides || []
  - const gallery = config.gallery || ''
  - const perView = config.perView != null ? config.perView : 3
  - const gap = config.gap != null ? config.gap : 15
  - const breakpointsJson = config.breakpoints ? JSON.stringify(config.breakpoints) : ''

  section.section.ui-slider(class=sectionClass)
    .container
      if title
        +sectionHead(title, subtitle, titleMods, subtitleMods, headMods)
      .ui-slider__root.glide.js-ui-slider(
        data-per-view=perView
        data-gap=gap
        data-breakpoints=breakpointsJson || undefined
      )
        .glide__track.ui-slider__track(data-glide-el='track')
          ul.ui-slider__list.glide__slides
            each slide in slides
              li.ui-slider__item.glide__slide
                if slide.href
                  a.ui-slider__link(
                    href=slide.href
                    data-gallery=slide.galleryGroup || gallery || undefined
                  )
                    img(src=slide.src alt=slide.alt || '')
                else
                  .ui-slider__media
                    img(src=slide.src alt=slide.alt || '')
        .ui-slider__arrows(data-glide-el='controls')
          button.ui-slider__arrow.ui-slider__arrow--prev(
            type='button'
            data-glide-dir='<'
            aria-label='Предыдущий слайд'
          )
            +icon('chevron-right')
          button.ui-slider__arrow.ui-slider__arrow--next(
            type='button'
            data-glide-dir='>'
            aria-label='Следующий слайд'
          )
            +icon('chevron-right')
