mixin feedbackForm()
  <section class="feedback-form section section--padd">
    <div class="container">
      <div class="feedback-form__inner js-feedback-form">
        <div class="feedback-form__body">
          <div class="feedback-form__info">
            <h2 class="feedback-form__title">текст</h2>
            <p class="feedback-form__text">текст</p>
          </div>
          <div class="feedback-form__form-wrap">
            <form class="feedback-form__form" action="#" method="post" novalidate>
              <input class="feedback-form__input" type="text" name="name" placeholder="Как к вам обращаться?" required />
              <input class="feedback-form__input" type="tel" name="phone" placeholder="+7 (___) ___-__-__" required />
              <textarea class="feedback-form__input feedback-form__input--textarea" name="message" rows="4" placeholder="Опишите Ваш запрос"></textarea>
              <label class="feedback-form__checkbox">
                <input type="checkbox" name="agree" required checked />
                <span>Даю согласие на обработку персональных данных в соответствии с <a href="./policy.html">Политикой конфиденциальности</a></span>
              </label>
              <button class="feedback-form__submit btn btn--primary" type="submit">Получить консультацию</button>
            </form>
          </div>
        </div>
        <div class="feedback-form__success">
          <div class="feedback-form__success-avatar" aria-hidden="true"></div>
          <h2 class="feedback-form__success-title">Спасибо за обращение</h2>
          <p class="feedback-form__success-text">Ваша заявка успешно отправлена. Наш специалист свяжется с вами в ближайшее время для уточнения деталей.</p>
          <button class="feedback-form__submit btn btn--primary" type="button" data-feedback-success-close>Хорошо</button>
        </div>
      </div>
    </div>
  </section>
